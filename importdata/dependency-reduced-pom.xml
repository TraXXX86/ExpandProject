<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>expand</artifactId>
    <groupId>fr.expand.project</groupId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>importpackage</artifactId>
  <name>ImportPackage</name>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>jaxb2-maven-plugin</artifactId>
          <version>3.1.0</version>
          <executions>
            <execution>
              <id>generate-datapack</id>
              <phase>generate-sources</phase>
              <goals>
                <goal>xjc</goal>
              </goals>
              <configuration>
                <packageName>fr.expand.project.importdata.dto.generated</packageName>
                <outputDirectory>src/main/java</outputDirectory>
                <sources>
                  <source>src/main/resources/datapack/data.xsd</source>
                </sources>
                <clearOutputDir>false</clearOutputDir>
              </configuration>
            </execution>
            <execution>
              <id>generate-model</id>
              <phase>generate-sources</phase>
              <goals>
                <goal>xjc</goal>
              </goals>
              <configuration>
                <packageName>fr.expand.project.importdata.model.generated</packageName>
                <outputDirectory>src/main/java</outputDirectory>
                <sources>
                  <source>src/main/resources/model/model.xsd</source>
                </sources>
                <clearOutputDir>false</clearOutputDir>
              </configuration>
            </execution>
          </executions>
          <dependencies>
            <dependency>
              <groupId>org.jvnet.jaxb2_commons</groupId>
              <artifactId>jaxb2-value-constructor</artifactId>
              <version>3.0</version>
            </dependency>
          </dependencies>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>jaxb2-maven-plugin</artifactId>
        <version>3.1.0</version>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>fr.expand.project.importdata.Launcher</mainClass>
              <addClasspath>true</addClasspath>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>fr.expand.project.importdata.Launcher</mainClass>
                </transformer>
              </transformers>
              <finalName>expandproject-importdata</finalName>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
