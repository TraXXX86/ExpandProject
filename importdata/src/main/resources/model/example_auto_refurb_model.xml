                </ATTRIBUTE_GROUP>
                <ATTRIBUTE_GROUP NAME="Competences" ORDER="2">
                    <ATTRIBUTE_REF NAME="SPECIALITE" ORDER="1"/>
                    <ATTRIBUTE_REF NAME="NIVEAU" ORDER="2"/>
                </ATTRIBUTE_GROUP>
                <ATTRIBUTE_GROUP NAME="RH" ORDER="3">
                    <ATTRIBUTE_REF NAME="DATE_EMBAUCHE" ORDER="1"/>
                    <ATTRIBUTE_REF NAME="ACTIF" ORDER="2"/>
                </ATTRIBUTE_GROUP>
            </ATTRIBUTE_GROUPS>
        </OBJECT_TYPE>
    </OBJECT_TYPES>

    <LINK_TYPES>
        <!-- Lien entre mandat et véhicule -->
        <LINK_TYPE NAME="MANDAT_POUR_VEHICULE" DIRECTED="true">
            <DESCRIPTION>Mandat associé au véhicule</DESCRIPTION>
            <LABELS>
                <LABEL LANGUAGE="FR_fr" VALUE="Mandat véhicule"/>
                <LABEL LANGUAGE="EN_uk" VALUE="Vehicle work order"/>
            </LABELS>
            <SOURCE_LABELS>
                <LABEL LANGUAGE="FR_fr" VALUE="Concerne véhicule"/>
                <LABEL LANGUAGE="EN_uk" VALUE="Targets vehicle"/>
            </SOURCE_LABELS>
            <TARGET_LABELS>
                <LABEL LANGUAGE="FR_fr" VALUE="A pour mandat"/>
                <LABEL LANGUAGE="EN_uk" VALUE="Has work order"/>
            </TARGET_LABELS>
            <SOURCE_TYPES>
                <TYPE_REF NAME="MANDAT_REPARATION"/>
            </SOURCE_TYPES>
            <TARGET_TYPES>
                <TYPE_REF NAME="VEHICULE"/>
            </TARGET_TYPES>
            <ATTRIBUTE_DEFINITIONS>
                <ATTRIBUTE_DEFINITION NAME="TYPE_INTERVENTION" TYPE="STRING" REQUIRED="false">
                    <DESCRIPTION>Type d'intervention</DESCRIPTION>
                </ATTRIBUTE_DEFINITION>
                <ATTRIBUTE_DEFINITION NAME="KILOMETRAGE_ENTREE" TYPE="INTEGER" REQUIRED="false">
                    <DESCRIPTION>Kilométrage à l'entrée</DESCRIPTION>
                </ATTRIBUTE_DEFINITION>
            </ATTRIBUTE_DEFINITIONS>
        </LINK_TYPE>

        <!-- Lien entre mandat et centre -->
        <LINK_TYPE NAME="MANDAT_GERE_PAR_CENTRE" DIRECTED="true">
            <DESCRIPTION>Mandat géré par un centre</DESCRIPTION>
            <LABELS>
                <LABEL LANGUAGE="FR_fr" VALUE="Mandat centre"/>
